# Example for the operator's later public HTTPS ingress. Replace the hostname
# and provision its TLS certificate before enabling this server block.
server {
    listen 80;
    server_name cururu.example.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name cururu.example.com;

    ssl_certificate /etc/letsencrypt/live/cururu.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cururu.example.com/privkey.pem;
    client_max_body_size 1m;

    location = /health {
        proxy_pass http://127.0.0.1:8080/health;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /v1/webhooks/github {
        proxy_pass http://127.0.0.1:8080/v1/webhooks/github;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering on;
        proxy_read_timeout 30s;
    }

    location / {
        return 404;
    }
}
