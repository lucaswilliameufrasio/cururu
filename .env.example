GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_SLUG=replace-with-github-app-slug
GITHUB_APP_PRIVATE_KEY_FILE=./secrets/cururu-app.private-key.pem
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
LLM_API_KEY=replace-with-your-provider-key
CURURU_DB_PASSWORD=replace-with-a-long-random-database-password
CURURU_PORT=8080
# Set your host's Tailscale IPv4 address to use compose.tailscale.yaml.
# CURURU_TAILSCALE_IP=100.64.0.1
# Optional Compose Tailscale overlay; use the host's `tailscale ip -4` address.
# CURURU_TAILSCALE_IP=100.98.74.9
# Optional for GitHub Enterprise Server.
GITHUB_API_URL=https://api.github.com
